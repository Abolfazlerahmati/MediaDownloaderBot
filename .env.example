# ---------------------------------------------------------------------------
# MediaDownloaderBot - environment configuration (PLACEHOLDER VALUES ONLY)
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# REQUIRED. Secret used to sign/derive internal keys (HMAC for privacy-preserving
# user keys, encryption of the bot token stored from the admin panel).
# At least 32 characters. Generate with:  python -m mediabot.cli gen-secret
APP_SECRET_KEY=replace-with-output-of-gen-secret-command-min-32-chars

# Telegram bot token from @BotFather. Optional here: you can also set it from the
# admin panel (stored encrypted with APP_SECRET_KEY). Format: 123456789:AA...
BOT_TOKEN=

# Where SQLite database and temporary files live.
DATA_DIR=./data
# DATABASE_PATH=./data/app.db
# TEMP_DIR=./data/tmp

# Admin web panel bind address. Use 127.0.0.1 unless you put it behind a reverse proxy
# with TLS. Docker compose binds 0.0.0.0 inside the container and publishes to localhost only.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Secure cookies require HTTPS. Set to false only for plain-HTTP local/LAN testing.
ADMIN_COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Run the Telegram bot and/or the web panel in this process.
ENABLE_BOT=true
ENABLE_WEB=true

# minimal  = keep only per-user language preference (HMAC-hashed user key) with retention
# temporary = keep nothing across restarts (language resets to default after restart)
PERSISTENCE_MODE=minimal

# Optional explicit path to an ffmpeg/ffprobe-capable ffmpeg binary.
# If unset, the system PATH is searched, then the bundled imageio-ffmpeg binary is used.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Set to true when a supervisor (Docker restart policy, systemd with
# RestartForceExitStatus=75) restarts the process after a panel-initiated restart.
RESTART_SUPERVISED=false
